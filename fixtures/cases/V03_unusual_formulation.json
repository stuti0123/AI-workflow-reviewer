  "requirements_doc": {
   "doc_id": "support-policy",
   "requirements": [
    {
     "anchor": "policy.md#R1",
     "id": "R1",
     "order": 10,
     "text": "If the category is missing, route to manual review."
    },
    {
     "anchor": "policy.md#R2",
     "id": "R2",
     "order": 20,
     "text": "Otherwise, if the ticket is urgent, route to priority queue."
    },
    {
     "anchor": "policy.md#RG",
     "id": "RG",
     "order": 30,
     "text": "Otherwise, if tier is gold and waiting time is at least 15 minutes, route to priority queue."
    },
    {
     "anchor": "policy.md#R3",
     "id": "R3",
     "order": 40,
     "text": "Otherwise, if waiting time is at least 30 minutes, route to escalation."
    },
    {
     "anchor": "policy.md#R3x",
     "id": "R3x",
     "kind": "exception",
     "order": 45,
     "parent": "R3",
     "text": "Exception to R3: if tier is vip, route to priority queue."
    },
    {
     "anchor": "policy.md#R4",
     "id": "R4",
     "order": 90,
     "text": "All remaining tickets are routed to the normal queue."
    }
   ],
   "version": "v3"
  },
  "schema_version": "1",
  "snippets": [
   {
    "entry": "route",
    "id": "route_py",
    "language": "python",
    "location": "routing.py",
    "source": "def route(t):\n    c = t.get(\"category\")\n    if c is None:\n        return \"manual_review\"\n    w = t[\"waiting_minutes\"]\n    if t[\"urgent\"]:\n        return \"priority_queue\"\n    if t[\"tier\"] == \"gold\" and w >= 15:\n        return \"priority_queue\"\n    if not (w < 30):\n        if t[\"tier\"] in (\"vip\",):\n            return \"priority_queue\"\n        return \"escalation\"\n    return \"normal_queue\"\n",
    "version": "v3"
   }
  ],
