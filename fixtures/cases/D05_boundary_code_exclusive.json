     "id": "R1",
     "order": 10,
     "text": "If the category is missing, route to manual review."
    },
    {
     "anchor": "policy.md#R2",
     "id": "R2",
     "order": 20,
     "text": "Otherwise, if the ticket is urgent, route to priority queue."
    },
    {
     "anchor": "policy.md#R3",
     "id": "R3",
     "order": 40,
     "text": "Otherwise, if waiting time is at least 30 minutes, route to escalation."
    },
    {
     "anchor": "policy.md#R4",
     "id": "R4",
     "order": 90,
     "text": "All remaining tickets are routed to the normal queue."
    }
   ],
   "version": "v3"
  },
