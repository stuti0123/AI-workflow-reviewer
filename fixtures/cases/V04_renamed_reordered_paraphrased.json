    "language": "python",
    "location": "routing.py",
    "source": "def route(t):\n    if t[\"category\"] is None:\n        return \"manual_review\"\n    if t[\"urgent\"]:\n        return \"priority_queue\"\n    if t[\"waiting_minutes\"] >= 30:\n        return \"escalation\"\n    return \"normal_queue\"\n",
    "version": "v3"
   }
