{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/shodh-review/bundle.schema.json",
  "title": "Review bundle (schema_version 1)",
  "type": "object",
  "required": ["bundle_id", "schema_version", "requirements_doc", "approvals", "specification", "workflow", "snippets"],
  "additionalProperties": false,
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1"},
    "requirements_doc": {
      "type": "object", "required": ["doc_id", "version", "requirements"], "additionalProperties": false,
      "properties": {
        "doc_id": {"type": "string"}, "version": {"type": "string"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
      }
    },
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "specification": {
      "type": "object", "required": ["artifact_id", "version", "rules"], "additionalProperties": false,
      "properties": {
        "artifact_id": {"type": "string"}, "version": {"type": "string"}, "location": {"type": "string"},
        "default_route": {"type": "string"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/spec_rule"}}
      }
    },
    "workflow": {
      "type": "object", "required": ["artifact_id", "version", "entry", "nodes"], "additionalProperties": false,
      "properties": {
        "artifact_id": {"type": "string"}, "version": {"type": "string"}, "location": {"type": "string"}, "entry": {"type": "string"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    },
    "snippets": {"type": "array", "items": {"$ref": "#/$defs/snippet"}}
  },
  "$defs": {
    "requirement": {
      "type": "object", "required": ["id", "anchor", "order", "text"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "anchor": {"type": "string", "description": "evidence location in the source document, e.g. policy.md#L12"},
        "order": {"type": "integer", "description": "semantic precedence; list position in the file is NOT semantic"},
        "text": {"type": "string"}, "kind": {"enum": ["rule", "exception", "default"]}, "parent": {"type": "string"}
      }
    },
    "approval": {
      "type": "object", "required": ["id", "target", "status", "applies_to_version", "seq", "change"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "target": {"type": "string"},
        "status": {"enum": ["approved", "suggested", "pending", "rejected"]},
        "applies_to_version": {"type": "string"}, "seq": {"type": "integer"}, "approved_by": {"type": "string"},
        "change": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "text": {"type": "string"},
            "replace": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}, "additionalProperties": false}
          },
          "oneOf": [{"required": ["text"]}, {"required": ["replace"]}]
        }
      }
    },
    "condition": {
      "type": "object", "required": ["op"],
      "properties": {
        "op": {"enum": ["true", "missing", "eq", "cmp", "and", "or", "not"]},
        "field": {"type": "string"}, "cmp": {"enum": ["<", "<=", ">", ">=", "=="]}, "value": {}, "unit": {"type": "string"},
        "args": {"type": "array", "items": {"$ref": "#/$defs/condition"}}, "arg": {"$ref": "#/$defs/condition"}
      }
    },
    "spec_rule": {
      "type": "object", "required": ["id", "order", "condition", "route"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "ref": {"type": "string", "description": "source requirement id; optional - semantic matching is used when absent or wrong"},
        "order": {"type": "integer"}, "condition": {"$ref": "#/$defs/condition"}, "route": {"type": "string"}, "location": {"type": "string"},
        "exceptions": {"type": "array", "items": {"type": "object", "required": ["condition", "route"], "properties": {"id": {"type": "string"}, "condition": {"$ref": "#/$defs/condition"}, "route": {"type": "string"}}}}
      }
    },
    "node": {
      "type": "object", "required": ["id", "version", "type"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "version": {"type": "string"}, "type": {"enum": ["decision", "terminal"]}, "location": {"type": "string"},
        "condition": {"$ref": "#/$defs/condition"}, "on_true": {"type": "string"}, "on_false": {"type": "string"}, "route": {"type": "string"}
      }
    },
    "snippet": {
      "type": "object", "required": ["id", "version", "language", "source", "location"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "language": {"const": "python"}, "source": {"type": "string"}, "entry": {"type": "string"}, "location": {"type": "string"}}
    }
  }
}
